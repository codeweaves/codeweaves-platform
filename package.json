{
  "name": "klivo-platform",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "test:cov": "turbo run test:cov",
    "seed:analytics": "turbo run seed:analytics",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:nuke": "docker compose down -v",
    "db:setup": "bun run --filter @repo/api db:assert-local && bun run db:up && bun run --filter @repo/api db:deploy && bun run --filter @repo/api db:seed",
    "db:pull": "bash scripts/db/pull-develop-data.sh"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "lefthook": "^2.1.12",
    "prettier": "^3.9.6",
    "turbo": "^2.10.6",
    "typescript": "5.9.2"
  },
  "packageManager": "bun@1.3.8",
  "engines": {
    "node": ">=18"
  },
  "overrides": {
    "multer": "2.3.0",
    "socket.io-parser": "4.2.7"
  }
}
