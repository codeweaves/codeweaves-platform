# Dependencies
node_modules
.pnp
.pnp.js

# Local env files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Testing
coverage

# Turbo
.turbo

# Vercel
.vercel

# Build Outputs
.next/
out/
build
dist


# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Runtime logs (AI traces, etc.)
apps/api/logs/

# Misc
.DS_Store
*.pem
*.tmp.*

# Prompt files
.claude/
.agents/
.vscode/
CLAUDE.md

AgentEditor/

# Old standalone widget (replaced by apps/widget)
/widget/

# Test pages (local dev only)
test-pages/

# Pino AI trace log files (rotated daily, persisted locally only)
logs/
apps/api/logs/

nul
NUL

# graphify knowledge graph — fully generated, regenerate anytime with /graphify.
# Ignored entirely so the large graph.json/graph.html never churn in commits.
graphify-out/

# RAG eval harness local artifacts (was apps/api/eval/.gitignore, which only
# exists on the eval feature branches — kept here so it holds on every branch).
apps/api/eval/.build/
apps/api/eval/.data/
apps/api/eval/results/

# Reference codebases (dify, onyx, r2r, ragflow, surfsense) — nested clones,
# ~1.5 GB, cloned locally per docs/patterns. Never part of this repo.
references/

# Zipped policy bundle — regenerate from docs/security/policies/
docs/security/policies.zip

# Internal security posture docs — NOT for a public repo.
# These enumerate our controls, assets, data flows, network topology and OPEN
# findings. Published, they are a map for an attacker. Keep them local or move
# them to a private repo. Nothing under policies/ belongs in this repo; the
# public-facing notices are published from the website, not from git.
docs/security/policies/*
docs/security/pre-assessment-fix-list.md
docs/security/questionnaire-answers.md

# Client/vendor security questionnaires and assessment workbooks. These are
# the client's confidential material as much as ours, and they restate our
# posture question by question. Never in a public repo.
docs/assessment/
