{
  "extends": "./tsconfig.json",
  // Build/run config. tsconfig.json stays wide so the editor and jest still see
  // test/**, but compiling tests on every watch rebuild made `bun run dev`
  // recompile all 129 suites per keystroke. That slow rebuild is what opened the
  // window for Node to start against a half-written dist/ and die on
  // "Cannot find module './modules/app.module'".
  //
  // The deploy starts dist/main.js, so src/ must be the only input. rootDir is
  // pinned rather than inferred: an inferred rootDir silently moves the output
  // to dist/src/main.js when any file outside src/ joins the build (it happened
  // with test/ before, and with scripts/ in PR #260), and the deploy then dies
  // on "Cannot find module dist/main". Pinned, such a file fails the build
  // instead. Folders tsconfig.json includes for the editor and type check but
  // that are not part of the server go in the exclude list below.
  //
  // With rootDir pinned, TypeScript puts the incremental build info next to
  // this file instead of inside dist/. "prebuild" deletes dist/ but not that
  // file, so the next build believes it is up to date and emits nothing. Keep
  // the build info inside the output folder so it is deleted with it.
  "compilerOptions": {
    "rootDir": "./src",
    "tsBuildInfoFile": "./dist/tsconfig.build.tsbuildinfo"
  },
  "exclude": [
    "node_modules",
    "dist",
    "test",
    "prisma.config.ts",
    "prisma",
    "eval",
    "scripts",
    "**/*.spec.ts",
    "**/*.e2e-spec.ts"
  ]
}
