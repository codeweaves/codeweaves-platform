{
  "name": "@repo/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch -p tsconfig.dev.json",
    "start": "nest start",
    "start:dev": "nest start --watch -p tsconfig.dev.json",
    "start:debug": "nest start --debug --watch -p tsconfig.dev.json",
    "start:prod": "node dist/main",
    "lint": "eslint . --max-warnings 0",
    "check-types": "tsc --noEmit",
    "test": "jest --config jest.config.cjs",
    "test:watch": "jest --config jest.config.cjs --watch",
    "test:cov": "jest --config jest.config.cjs --coverage",
    "test:e2e": "jest --config jest.e2e.config.cjs",
    "seed:analytics": "bunx tsx prisma/seed-analytics.ts",
    "seed:demo-agents": "bunx tsx prisma/seed-demo-agents.ts",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:assert-local": "bun run prisma/assert-local-db.ts",
    "prebuild": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "seed:verify": "bun run prisma/seed-verify.ts"
  },
