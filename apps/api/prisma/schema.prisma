// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  ADMIN
  CLIENT
}

enum AgentStatus {
  ACTIVE
  INACTIVE
}

enum DataFieldType {
  STRING
  NUMBER
  BOOLEAN
  DATE
  EMAIL
  PHONE
}

enum SessionStatus {
  ACTIVE
  EXPIRED
}

enum MessageRole {
  USER
  ASSISTANT
  // A human teammate replying after taking the conversation over.
  HUMAN_AGENT
  // System/event lines in the transcript (e.g. "Visitor asked for a human",
  // "You took over", "Resolved by <name>"). Never sent to the LLM as context.
  SYSTEM
}

/// Orthogonal to SessionStatus (ACTIVE|EXPIRED, which is the 6h-rotation
/// lifecycle). Drives the human-handover Inbox. NONE = bot handling normally;
/// REQUESTED = flag raised, bot keeps stalling, AI NOT paused; ACTIVE_HUMAN = a
/// teammate took over, AI paused. "Resolve" flips back to NONE + stamps
/// handoverResolvedAt (no separate RESOLVED state — a resolved chat just routes
/// back to the bot, and a new visitor message reopens it normally).
enum HandoverState {
  NONE
  REQUESTED
  ACTIVE_HUMAN
}

/// Why a handover was raised — for the Inbox label + analytics.
enum HandoverReason {
  USER_REQUESTED // explicit keyword/button: "talk to a human"
  BOT_FALLBACK // couldntAnswer streak — the bot kept failing
  FRUSTRATION // async sentiment check flagged it
  MANUAL // a teammate flagged it from the dashboard
}

enum ChatSource {
  DEMO
  WIDGET
  WHATSAPP
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
}

enum WhatsappChannelStatus {
  PENDING // created, not yet verified/connected
  CONNECTED // active — receiving + sending
  DISCONNECTED // intentionally turned off / token revoked
  ERROR // token expired or Meta returned errors
}

// Outbound template categories (Meta). NOTE: SERVICE is not a template category —
// "service" = free-form replies within the 24h window. Templates are only these three.
enum WhatsappTemplateCategory {
  MARKETING
  UTILITY
  AUTHENTICATION
}

// Mirrors Meta's template review lifecycle.
enum WhatsappTemplateStatus {
  DRAFT // local only, not yet submitted to Meta
  PENDING // submitted, awaiting Meta review
  APPROVED
  REJECTED
  PAUSED
  DISABLED
}

model Organization {
  id        String    @id @default(uuid())
  name      String
  slug      String    @unique
  users     User[]
  agents    Agent[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([slug])
  @@map("organizations")
}

model User {
  id                String        @id @default(uuid())
  email             String        @unique
  name              String?
  role              Role          @default(CLIENT)
  clerkId           String?       @unique
  organizationId    String?
  organization      Organization? @relation(fields: [organizationId], references: [id])
  // Chat sessions this user has taken over in the live-handover Inbox.
  takenOverSessions ChatSession[] @relation("SessionTakenOverBy")
  deletedAt         DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([organizationId])
  @@index([clerkId])
  @@map("users")
}

model UserInvitation {
  id                String           @id @default(uuid())
  email             String
  role              Role             @default(CLIENT)
  organizationId    String?
  token             String           @unique @default(uuid())
  reissueToken      String           @unique @default(uuid())
  reissueCount      Int              @default(0)
  status            InvitationStatus @default(PENDING)
  expiresAt         DateTime
  createdAt         DateTime         @default(now())
  invitedBy         String?
  clerkInvitationId String?

  @@unique([email, status, organizationId])
  @@index([email])
  @@index([organizationId])
  @@index([token])
  @@index([status])
  @@map("user_invitations")
}

model Agent {
  id                    String             @id @default(uuid())
  publicId              String             @unique @db.VarChar(8)
  name                  String
  status                AgentStatus        @default(ACTIVE)
  organizationId        String
  organization          Organization       @relation(fields: [organizationId], references: [id])
  allowedDomains        String[]
  hmacEnabled           Boolean            @default(false)
  voiceEnabled          Boolean            @default(false)
  voiceConfig           Json?              @db.JsonB
  // Per-agent AI orchestration config: routing mode (n8n | direct), model,
  // temperature, context strategy, fallback models, RAG settings.
  // Null/absent = defaults to 'n8n' routing for backwards compatibility.
  aiConfig              Json?              @db.JsonB
  // Category names this agent's conversations get classified into by the
  // post-session AI classifier (e.g. ["Pricing", "Support", "Refunds"]).
  // Empty array disables categorisation for the agent.
  categoryKeywords      String[]           @default([])
  // How long a single chat session can live (from createdAt) before the
  // backend rotates the visitor to a new sessionId. Tighter values produce
  // more "distinct conversations" in analytics; looser values let one visit
  // stay continuous longer. Range 1-168 (1h to 1 week), default 6h.
  sessionLifetimeHours  Int                @default(6)
  // Languages this agent's conversations get classified against by the same
  // post-session classifier. Codes are mostly ISO 639-1 (en, hi, mr, …) plus
  // one non-standard value: `hinglish` (code-mixed Hindi-English, Latin script).
  // Empty array disables language detection for the agent.
  supportedLanguages    String[]           @default([])
  // Up to 3 phrases the agent replies with when it can't answer from its
  // knowledge. Injected into the system prompt; replies are fuzzy-matched
  // against these to flag "couldn't answer" in analytics. Empty = feature off.
  fallbackPhrases       String[]           @default([])
  // --- Human handover (live agent takeover) ---
  // Master switch: when false the whole takeover feature is off for this bot
  // (no triggers, no flag, no Inbox entries).
  humanTakeoverEnabled  Boolean            @default(false)
  // Optional: render a "Talk to a human" button in the widget. Only meaningful
  // when humanTakeoverEnabled is true.
  showTalkToHumanButton Boolean            @default(false)
  // What the visitor sees in the widget when a teammate connects, e.g.
  // "You're now chatting with our team". Null = a sensible built-in default.
  humanConnectedLabel   String?            @db.VarChar(160)
  systemPrompt          String?            @db.Text
  welcomeMessage        String?
  secret                AgentSecret?
  theme                 AgentTheme?
  knowledge             AgentKnowledge?
  whatsappChannel       WhatsappChannel?
  whatsappTemplates     WhatsappTemplate[]
  dataFields            AgentDataField[]
  collectedData         CollectedData[]
  chatSessions          ChatSession[]
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  deletedAt             DateTime?

  @@index([publicId])
  @@index([organizationId])
  @@index([status])
  @@map("agents")
}

model AgentSecret {
  id         String   @id @default(uuid())
  agentId    String   @unique
  agent      Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  webhookUrl String?  @db.Text
  apiKey     String?  @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([agentId])
  @@map("agent_secrets")
}

model AgentTheme {
  id        String   @id @default(uuid())
  agentId   String   @unique
  agent     Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  config    Json // Stores full WidgetTheme object as JSONB
  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([agentId])
  @@map("agent_themes")
}

/// Per-agent "static knowledge base" — text that gets prepended to the system
/// prompt on every chat. This is the NON-RAG approach for small knowledge
/// bases: paste some text or upload a file (we extract and discard), and the
/// agent sees it on every message. For large KBs (many files, tens of thousands
/// of tokens), use the RAG pipeline (Phase 3) instead.
///
/// Stored as a separate table (not a column on Agent) because the content can
/// be large (up to ~500 KB / ~125K tokens) and we don't want every agent-list
/// query dragging it across the wire.
model AgentKnowledge {
  id      String @id @default(uuid())
  agentId String @unique
  agent   Agent  @relation(fields: [agentId], references: [id], onDelete: Cascade)

  /// Extracted / pasted text. Prepended to the agent's system prompt at chat time.
  content String @db.Text

  /// Cached token count (computed via TokenCounterService on write). Lets the
  /// dashboard display "12,400 tokens" without tokenising on every read.
  contentTokens Int?

  /// Filename of the uploaded source, if any. Helpful in the UI: "Knowledge
  /// extracted from refund-policy.pdf · 12,400 tokens". Null when admin pasted
  /// text directly.
  sourceFileName String? @db.VarChar(255)

  /// MIME type of the uploaded source, if any. Used only for UI labels.
  sourceMimeType String? @db.VarChar(127)

  /// Size of the original file before text extraction, in bytes. Null when
  /// admin pasted text directly.
  sourceSizeBytes Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([agentId])
  @@map("agent_knowledge")
}

/// Customer-defined fields this agent should capture from conversations (e.g.
/// name/email/phone for a sales bot, employeeId for an HR bot). These are
/// DEFINITIONS only — captured values land in CollectedData. The list is
/// injected into the system prompt ("collect these…", in-band, no extra LLM
/// call) and drives the background extractor that pulls values out of
/// finished conversations. See docs/plans/agent-data-and-integrations-plan.md.
model AgentDataField {
  id      String @id @default(uuid())
  agentId String
  agent   Agent  @relation(fields: [agentId], references: [id], onDelete: Cascade)

  /// Machine name used as the JSON key in CollectedData.data (e.g. "email").
  /// Immutable once created — renaming would orphan historical values. Unique
  /// per agent.
  key String @db.VarChar(64)

  /// Human label shown in the dashboard, e.g. "Email address".
  label String @db.VarChar(100)

  /// Value type. Drives extraction hinting now; (later) validation + reporting.
  type DataFieldType @default(STRING)

  /// Whether the agent should proactively ask for this when the visitor hasn't
  /// volunteered it. Optional fields are captured only if mentioned.
  required Boolean @default(false)

  /// Optional natural-language hint for the extractor, e.g. "the 6-digit order
  /// number". Helps the LLM pull the right value.
  description String? @db.Text

  /// Display + extraction ordering.
  order Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([agentId, key])
  @@index([agentId])
  @@map("agent_data_fields")
}

/// Values captured from a single conversation, keyed by the agent's
/// AgentDataField definitions. One row per chat session, upserted by the
/// background extractor (NOT on the reply hot path). `data` is a flat JSONB
/// object { "<field.key>": <value> } so adding a new field never touches the
/// schema. Restricted on agent delete (preserves captured leads, mirroring
/// ChatSession), cascades on session delete (mirroring ChatMessage).
model CollectedData {
  id            String      @id @default(uuid())
  agentId       String
  agent         Agent       @relation(fields: [agentId], references: [id])
  chatSessionId String      @unique
  chatSession   ChatSession @relation(fields: [chatSessionId], references: [id], onDelete: Cascade)

  /// Captured values keyed by AgentDataField.key, e.g. { "email": "a@b.com" }.
  data Json @db.JsonB

  /// When the extractor last wrote this row.
  extractedAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([agentId])
  @@map("collected_data")
}

/// A WhatsApp number connected to an agent. The webhook routes each inbound message
/// to the owning agent via `phoneNumberId` (Meta's per-number id, present on every
/// webhook payload). One number per agent for now.
///
/// MVP stores the WABA id + access token on the channel itself (manual config). When
/// Embedded Signup lands, the WABA + token become org-level (one WABA can own many
/// numbers) and this model will reference that — see docs/plans/whatsapp-integration-plan.md.
model WhatsappChannel {
  id      String @id @default(uuid())
  agentId String @unique
  agent   Agent  @relation(fields: [agentId], references: [id], onDelete: Cascade)

  /// WhatsApp Business Account id that owns this number.
  wabaId String

  /// Meta's phone-number id — the routing key. Every inbound webhook payload carries
  /// this under `metadata.phone_number_id`; we resolve the agent by it.
  phoneNumberId String @unique

  /// Human-readable number for the dashboard, e.g. "+1 555 010 1234".
  displayPhone String

  /// Business display name Meta shows to end users (verified name). Optional.
  verifiedName String?

  /// Graph API access token, encrypted at rest via CryptoService (AES-256-GCM) — the
  /// same mechanism AgentSecret uses for webhook URLs. NEVER store or log plaintext.
  accessTokenEnc String @db.Text

  /// When the access token expires (Embedded Signup tokens are typically 60-day).
  /// Null for non-expiring system-user tokens. Drives proactive refresh later.
  tokenExpiresAt DateTime?

  status WhatsappChannelStatus @default(PENDING)

  /// When true, the agent replies with a voice note (TTS) to inbound voice notes.
  /// Text inbound always gets a text reply regardless. Default off (text-out).
  voiceReplyEnabled Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // No explicit @@index: both phoneNumberId and agentId are @unique, which already
  // creates a backing index. The webhook routes on phoneNumberId via that unique index.
  @@map("whatsapp_channels")
}

/// Outbound message templates. DORMANT: the schema is in place so enabling outbound
/// later is additive, but nothing reads or writes this yet (no UI, no Meta submission,
/// no sending). See docs/plans/whatsapp-integration-plan.md §7.
model WhatsappTemplate {
  id      String @id @default(uuid())
  agentId String
  agent   Agent  @relation(fields: [agentId], references: [id], onDelete: Cascade)

  /// Template name (Meta requires lowercase snake_case; unique per WABA + language).
  name String

  /// Meta language code, e.g. "en_US".
  language String

  category WhatsappTemplateCategory
  status   WhatsappTemplateStatus   @default(DRAFT)

  /// Meta's template id, once submitted/approved. Null while DRAFT.
  metaTemplateId String?

  /// Body text (may contain {{1}} placeholders).
  body String @db.Text

  /// Full component structure (header/body/footer/buttons) as sent to Meta.
  components Json? @db.JsonB

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // The composite unique's leftmost column (agentId) already serves "templates by
  // agent" lookups, so no separate @@index([agentId]) is needed.
  @@unique([agentId, name, language])
  @@map("whatsapp_templates")
}

model ChatSession {
  id                  String          @id @default(uuid())
  agentId             String
  agent               Agent           @relation(fields: [agentId], references: [id]) // RESTRICT: sessions are analytics data, must not cascade-delete with agent
  sessionId           String          @unique
  source              ChatSource      @default(DEMO)
  visitorId           String? // IP address (web/widget) or phone number (WhatsApp)
  status              SessionStatus   @default(ACTIVE)
  // Auto-generated concise title (5-8 words) derived from the first few
  // exchanges. Populated asynchronously after the 2nd assistant reply.
  // Used by conversation list UIs and analytics. Null until generated.
  title               String?         @db.VarChar(200)
  // Running summary of earlier conversation, rebuilt OFF the reply path by
  // SummaryRefreshService whenever a turn's context assembly truncated
  // history. Postgres is the single source of truth (no per-pod caches); the
  // hybrid context strategy reads this column on truncating turns.
  summary             String?         @db.Text
  // Generation marker: total message count when `summary` was last built.
  // Refresh skips when this equals the live count (summary already current).
  summaryMessageCount Int?
  // Conversation category picked by the post-session LLM classifier from the
  // agent's `categoryKeywords` list. Null until classification runs (after a
  // period of inactivity) or when the agent has no keywords configured.
  category            String?         @db.VarChar(100)
  // Primary language of the conversation, detected by the same classifier
  // pass. ISO 639-1 code (e.g. "en", "hi", "mr"). Null when undetermined.
  detectedLanguage    String?         @db.VarChar(8)
  // Timestamp of the most recent classifier run. Used to skip already-
  // classified sessions and (later) to expire stale labels when keywords change.
  categorizedAt       DateTime?
  // When the background data-capture extraction should next run for this
  // session. Set to `now + debounce` on each user-facing turn (each new message
  // pushes it forward = debounce), then cleared once extraction has run. A
  // Postgres-poll runner (`runDuePass`) picks up rows where this is <= now — no
  // Redis/queue involved. Null = nothing pending.
  extractionDueAt     DateTime?
  // --- Human handover (live agent takeover) ---
  // Orthogonal to `status`. Drives the Inbox. See HandoverState enum.
  handoverState       HandoverState   @default(NONE)
  handoverReason      HandoverReason?
  // When the flag was first raised (bot still replying while REQUESTED).
  handoverRequestedAt DateTime?
  // The teammate currently handling the chat (set on Take over). RESTRICT —
  // a User who has handled chats must not silently vanish from the audit trail.
  takenOverById       String?
  takenOverBy         User?           @relation("SessionTakenOverBy", fields: [takenOverById], references: [id], onDelete: SetNull)
  handoverStartedAt   DateTime?
  // Set when the teammate clicks Resolve (handoverState flips back to NONE).
  // Non-null = "a human resolved this" → the human-resolved analytics count.
  handoverResolvedAt  DateTime?
  messages            ChatMessage[]
  collectedData       CollectedData?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  lastMessageAt       DateTime?

  @@index([agentId])
  @@index([source])
  @@index([visitorId])
  @@index([category])
  @@index([detectedLanguage])
  // Lets the extraction poll find due sessions cheaply without scanning the
  // table; the `<= now` range query uses this index and skips nulls.
  @@index([extractionDueAt])
  // The Inbox lists sessions where handoverState != NONE, scoped per agent.
  @@index([agentId, handoverState])
  @@map("chat_sessions")
}

model ChatMessage {
  id            String              @id @default(uuid())
  chatSessionId String
  chatSession   ChatSession         @relation(fields: [chatSessionId], references: [id], onDelete: Cascade)
  role          MessageRole
  content       String              @db.Text
  metadata      Json?
  createdAt     DateTime            @default(now())
  metrics       ChatMessageMetrics?

  @@index([chatSessionId])
  @@index([chatSessionId, role])
  @@index([createdAt])
  @@map("chat_messages")
}

/// Typed analytics metrics, 1:1 with ChatMessage. Replaces the drifting
/// `chat_messages.metadata` JSONB for everything analytics aggregates. Written
/// exclusively through MessageMetricsService so column names can't diverge per
/// pipeline. n8n is retired, so there is no routingMode/n8n-timestamp surface.
model ChatMessageMetrics {
  messageId String      @id
  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  /// Copy of the message's (immutable) createdAt so analytics can time-scope without a second join.
  createdAt DateTime

  // ---- channel / mode ----
  inputType String? // 'text' | 'voice'
  streamed  Boolean? // streamed token-by-token vs buffered/sync

  // ---- backend / LLM timing (ms) ----
  responseLatencyMs  Int? // backend wall-clock: user msg received -> reply sent
  llmLatencyMs       Int? // LLM generation time only
  timeToFirstTokenMs Int? // LLM time-to-first-token
  timeToLastTokenMs  Int?
  streamDurationMs   Int?
  totalChunks        Int?
  backendReceivedAt  DateTime?
  backendRespondedAt DateTime?

  // ---- LLM cost / tokens (direct mode) ----
  model             String?
  traceId           String?
  costUsd           Decimal? @db.Decimal(12, 6)
  inputTokens       Int?
  outputTokens      Int?
  totalTokens       Int?
  cachedInputTokens Int?
  reasoningTokens   Int?
  finishReason      String?
  historyCount      Int?
  historyTruncated  Boolean?

  // ---- STT (voice input / USER message) ----
  sttProvider        String?
  sttLatencyMs       Int?
  detectedLanguage   String?
  languageConfidence Decimal? @db.Decimal(4, 3)

  // ---- TTS (voice reply / ASSISTANT message) ----
  ttsProvider              String?
  ttsProtocol              String? // 'http' | 'websocket' | 'mixed'
  ttsLatencyMs             Int?
  timeToFirstAudioMs       Int?
  voiceTotalLatencyMs      Int?
  totalSentences           Int?
  wsAvgFirstChunkLatencyMs Int?
  wsTotalChunks            Int?
  wsTotalBytes             Int?

  // ---- WhatsApp ----
  waInboundId  String?
  waOutboundId String?
  delivered    Boolean?
  replyMode    String? // 'text' | 'voice'

  // ---- fallback ("couldn't answer") ----
  couldntAnswer      Boolean?
  couldntAnswerScore Decimal? @db.Decimal(4, 3) // best fuzzy-match score vs the agent's phrases

  // ---- errors ----
  errored   Boolean?
  errorCode String?

  @@index([createdAt])
  @@index([sttProvider])
  @@index([ttsProvider])
  @@map("chat_message_metrics")
}

model File {
  id             String   @id @default(uuid())
  fileName       String
  mimeType       String
  sizeBytes      Int
  storageKey     String
  publicUrl      String
  bucket         String   @default("agent-assets")
  entityType     String
  entityId       String
  purpose        String
  organizationId String
  uploadedById   String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([entityType, entityId])
  @@index([organizationId])
  @@index([uploadedById])
  @@map("files")
}

model AuditLog {
  id            String   @id @default(uuid())
  correlationId String?
  userId        String?
  clerkId       String?
  contextId     String
  // Typed tenancy scope (contextId is polymorphic — agentId/userId/invitationId
  // depending on the caller — so it can't be queried by scope). These give a
  // reliable "what happened where" and let erasure delete an org's audit trail
  // by organizationId. Nullable: system/global events have neither.
  organizationId String?
  agentId        String?
  event         String
  data          Json
  createdAt     DateTime @default(now())

  @@index([event])
  @@index([contextId])
  @@index([userId])
  @@index([clerkId])
  @@index([correlationId])
  @@index([createdAt])
  @@index([organizationId])
  @@index([agentId])
  @@map("audit_logs")
}

/// Channel an EventLog row belongs to. "Widget logs" / "dashboard logs" are just
/// filters over this column (WHERE channel = 'WIDGET'). See observability plan §4.
enum EventChannel {
  WIDGET // public embeddable chat widget (POST /public/chat/*)
  DASHBOARD // authenticated app APIs (agents, orgs, conversations, analytics, …)
  WHATSAPP // WhatsApp inbound webhook + outbound Graph API
  VOICE // public voice conversation endpoint
  INTERNAL // cron / background jobs (classifier, data-extraction, handover sweep)
  SYSTEM // bootstrap, health, migrations
}

/// Direction of an EventLog row relative to us.
enum EventDirection {
  INBOUND // something arrived at us (a request, a channel message, a webhook)
  OUTBOUND // a call we made out (third-party) OR our response back to the client
  INTERNAL // an internal state-change / lifecycle event
}

/// Unified observability event log. Append-only, NO foreign keys (an audit row must
/// outlive what it references; fire-and-forget writes must never fail on a mid-delete
/// race — same pattern as AuditLog / ChatTrace / LlmUsage). Holds curated business
/// events, the HTTP envelope of mutating requests, and every third-party call
/// (LLM / STT / TTS / WhatsApp / n8n / email / clerk / storage). See observability plan.
model EventLog {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  channel   EventChannel
  eventName String // SCREAMING_SNAKE_CASE, e.g. WIDGET_MESSAGE_RECEIVED
  direction EventDirection @default(INTERNAL)
  provider  String? // ANTHROPIC | OPENAI | ELEVENLABS | SARVAM | DEEPGRAM | META_WHATSAPP | N8N | RESEND | CLERK | SUPABASE ; null for our own events

  // WHO
  actorUserId String? // internal users.id (dashboard actor); null for visitors
  clerkId     String? // clerk sub, cross-ref
  visitorId   String? // widget IP / whatsapp phone (mask phone before storing)

  // WHAT IT CONCERNS
  agentId        String?
  organizationId String?
  sessionId      String? // chat session id
  correlationId  String?

  // REQUEST (what we sent / received)
  requestUrl     String? // third-party URL or our route
  requestHeaders Json? // CUSTOM headers only, sanitized (never auth/cookie/api-key)
  requestPayload Json? // body sent/received, redacted + size-capped

  // RESPONSE (third-party response OR our response to the client)
  responseStatus  Int?
  responsePayload Json? // redacted + size-capped

  // OUTCOME
  latencyMs    Int?
  success      Boolean @default(true)
  errorMessage String?

  metadata Json? // extra: model, tokens, mime, durationMs, etc. (redacted + capped)

  @@index([channel, createdAt])
  @@index([agentId, createdAt])
  @@index([organizationId, createdAt])
  @@index([sessionId])
  @@index([correlationId])
  @@index([eventName])
  @@index([provider])
  @@index([actorUserId])
  // Bare createdAt index for the retention sweep (DELETE ... WHERE createdAt < cutoff);
  // the composite indexes above are led by other columns and can't serve it.
  @@index([createdAt])
  @@map("event_logs")
}

// AI orchestration trace: one row per conversation turn with all intermediate steps
// captured as a JSON array (context load, RAG retrieval, reranking, LLM call, etc.).
// Enables "replay" of exactly what happened for any message: what was retrieved,
// what was sent to the LLM, what came back, how long each step took.
model ChatTrace {
  id              String    @id @default(uuid())
  traceId         String    @unique // short ID (t_xxxxxxxxxx) for log correlation
  correlationId   String? // matches HTTP request correlation ID
  agentId         String
  sessionId       String?
  messageId       String? // ChatMessage.id once persisted
  userMessage     String?   @db.Text
  response        String?   @db.Text
  model           String? // actual model used (may differ from requested if fallback)
  steps           Json // TraceStep[] — each step's name, timing, and data
  startedAt       DateTime
  completedAt     DateTime?
  totalDurationMs Int?
  success         Boolean   @default(true)
  errorMessage    String?   @db.Text
  createdAt       DateTime  @default(now())

  @@index([agentId, createdAt])
  @@index([sessionId])
  @@index([correlationId])
  @@index([traceId])
  @@map("chat_traces")
}

// Per-LLM-call usage record. One row per generateText/streamText call.
// Powers: per-org cost tracking, model usage analytics, quota enforcement,
// cache hit rate measurement, retry/fallback monitoring.
model LlmUsage {
  id                String   @id @default(uuid())
  organizationId    String
  agentId           String
  sessionId         String?
  messageId         String?
  traceId           String? // link back to ChatTrace
  model             String // actual model used
  requestedModel    String // model requested (differs when fallback)
  promptTokens      Int
  completionTokens  Int
  totalTokens       Int
  cachedInputTokens Int? // tokens served from provider prompt cache (OpenAI/Gemini); null = unknown/not supported
  reasoningTokens   Int? // reasoning tokens consumed (Gemini thinking / OpenAI o1); null = none / N/A
  cost              Float? // USD, from OpenRouter response
  feature           String // 'chat' | 'voice' | 'rag-query' | 'embedding' | 'summarization' | 'rag-contextual' | 'rag-evaluation'
  latencyMs         Int
  cached            Boolean  @default(false)
  retryCount        Int      @default(0)
  finishReason      String?
  createdAt         DateTime @default(now())

  @@index([organizationId, createdAt])
  @@index([agentId, createdAt])
  @@index([feature])
  @@index([traceId])
  @@map("llm_usage")
}

// Reversible PII tokenization map ("vault"). One row per unique PII value per
// chat session: the LLM and persisted logs see the `token` placeholder
// ("[BANK_ACCOUNT_1]"); tool execution and any future masked-view rehydration
// resolve it back via this table. Values are AES-256-GCM encrypted; lookup is
// by session-scoped keyed HMAC (never by plaintext). HARD_DROP-tier
// identifiers (Aadhaar/PAN/cards/...) are destroyed at ingestion and are
// NEVER written here. See docs/plans/pii-redaction-plan.md.
model PiiToken {
  id             String   @id @default(uuid())
  organizationId String
  chatSessionId  String
  category       String // EMAIL | PHONE | IFSC | BANK_ACCOUNT | DOB | ...
  token          String // "[BANK_ACCOUNT_1]" — unique within the session
  valueHash      String // HMAC-SHA256(sessionId, normalized value) hex
  valueEncrypted String // AES-256-GCM (CryptoService format iv:data:tag)
  createdAt      DateTime @default(now())

  @@unique([chatSessionId, token])
  @@unique([chatSessionId, valueHash])
  @@index([organizationId])
  @@map("pii_tokens")
}
