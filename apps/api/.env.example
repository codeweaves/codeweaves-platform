# API Server Environment
NODE_ENV=development
PORT=3001

# Database (local PostgreSQL via docker-compose)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/codeweaves
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/codeweaves

# Database (Supabase - for staging/production)
# DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-1-ap-southeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true
# DIRECT_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-1-ap-southeast-2.pooler.supabase.com:5432/postgres

# Redis (local via docker-compose)
REDIS_URL=redis://localhost:6379

# Auth0
AUTH0_DOMAIN=your-tenant.jp.auth0.com
AUTH0_AUDIENCE=https://api.codeweaves.com
AUTH0_ISSUER_URL=https://your-tenant.jp.auth0.com/

# Auth0 Machine-to-Machine (Management API)
AUTH0_M2M_CLIENT_ID=your_m2m_client_id
AUTH0_M2M_CLIENT_SECRET=your_m2m_client_secret

# Auth0 SPA Client ID (used for password change ticket redirect)
AUTH0_SPA_CLIENT_ID=your_spa_client_id

# Resend (Email)
EMAIL_FROM="CodeWeaves <noreply@mail.codeweaves.com>"
RESEND_API_KEY=re_your_api_key_here

# Dashboard
DASHBOARD_URL=http://localhost:3000

# Agent Secrets Encryption (generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
AGENT_SECRET_KEY=

# Default webhook URL fallback (used when agent has no specific webhook configured)
DEFAULT_WEBHOOK_URL=

# Supabase Storage (file uploads)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Voice Providers
SARVAM_API_KEY=
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_DEFAULT_VOICE_ID=

# ==============================================================================
# AI Orchestration (Phase 1 — native LLM calls, runs alongside n8n)
# ==============================================================================

# Model ID prefix convention (set in agent.aiConfig.modelId or DEFAULT_AI_MODEL):
#   provider/model          → OpenRouter (default, e.g. 'openai/gpt-4o-mini')
#   openrouter:<same>       → OpenRouter (explicit)
#   openai:<model>          → OpenAI direct          (e.g. 'openai:gpt-4o-mini')
#   gemini:<model>          → Google AI Studio       (e.g. 'gemini:gemini-2.5-flash')
#   groq:<model>            → Groq direct            (e.g. 'groq:llama-3.3-70b-versatile')

# OpenRouter: multi-LLM gateway (300+ models, OpenAI-compatible API).
# Sign up: https://openrouter.ai/
OPENROUTER_API_KEY=

# OpenAI direct. Sign up: https://platform.openai.com/api-keys
# Use `openai:<model>` model IDs to route through this provider directly
# (bypassing OpenRouter's 5% BYOK fee / 5.5% credit fee).
OPENAI_API_KEY=
# Optional OpenAI organisation for billing attribution.
OPENAI_ORGANIZATION=

# Google AI Studio (Gemini) direct. Sign up (free tier, no card required):
# https://aistudio.google.com/apikey
# Use `gemini:<model>` model IDs (e.g. 'gemini:gemini-2.5-flash').
GOOGLE_API_KEY=

# Groq direct (Llama 3.3 70B, Mixtral, etc. at 400+ tok/sec). Free tier:
# 30 req/min, 6000 req/day, no card required. Sign up:
# https://console.groq.com/keys
# Use `groq:<model>` model IDs (e.g. 'groq:llama-3.3-70b-versatile').
GROQ_API_KEY=

# Sarvam AI — India-hosted, Indic-native models (Hindi, Marathi, Tamil + English).
# Chat completion is free as of 2026. ₹1,000 sign-up credit for paid services.
# Dashboard: https://dashboard.sarvam.ai/
# Use `sarvam:<model>` model IDs (e.g. 'sarvam:sarvam-30b').

# Cerebras Cloud — wafer-scale-chip inference. Headline feature is raw
# throughput: gpt-oss-120b at ~3000 tok/s, zai-glm-4.7 at ~1000 tok/s.
# Free tier limits: 5 req/min, 30K tokens/min, 1M tokens/day.
# Public/free models: `gpt-oss-120b`, `zai-glm-4.7`. (Qwen / Llama families are
# Dedicated-Endpoint only — use Groq for Qwen-3-32B on a free tier.)
# Console: https://cloud.cerebras.ai
# Use `cerebras:<model>` model IDs (e.g. 'cerebras:gpt-oss-120b').
CEREBRAS_API_KEY=

# Default model for agents that don't specify one.
#   Examples (prefixed forms pick the provider):
#     openai:gpt-4o-mini                  — OpenAI direct, cheap + fast
#     gemini:gemini-2.5-flash             — Google direct, cheap + fast
#     groq:llama-3.3-70b-versatile        — Groq direct, fastest free option
#     meta-llama/llama-3.3-70b-instruct:free  — OpenRouter free-tier
DEFAULT_AI_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Streaming timeout in milliseconds. If no token received within this window,
# the stream is aborted and an error is returned.
AI_STREAM_TIMEOUT_MS=60000

# Keep-alive heartbeat interval for LLM provider connections, in milliseconds.
# Default 25000ms (25s). Set to 0 to disable — first chat after a 30s+ idle
# period will then re-pay the TLS handshake (~300-3000ms cold-start tax).
# Tuned to undici's ~30s keep-alive timeout: 25s ensures sockets never go
# idle long enough to be closed. Cost: ~12k cheap unauthenticated GETs/hour
# per provider — trivial against any rate limit.
AI_KEEPALIVE_HEARTBEAT_MS=25000

# AI trace logging (Pino-backed, file + terminal)
# AI_TRACE_LOG_LEVEL     pino level: trace|debug|info|warn|error|fatal  (default: info)
# AI_TRACE_LOG_DIR       where ai-trace.log lives                       (default: logs)
# AI_TRACE_LOG_STDOUT    '1' to force terminal output in prod           (default: dev only)
# AI_TRACE_LOG_FILE      '0' to disable file output                     (default: enabled)
AI_TRACE_LOG_LEVEL=info
AI_TRACE_LOG_DIR=logs
