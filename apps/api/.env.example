# API Server Environment
NODE_ENV=development
PORT=3001

# Database (local PostgreSQL via docker-compose)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/codeweaves
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/codeweaves

# Database (Supabase - for staging/production)
# DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-1-ap-southeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true
# DIRECT_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-1-ap-southeast-2.pooler.supabase.com:5432/postgres

# Redis (local via docker-compose)
REDIS_URL=redis://localhost:6379

# Cross-instance fan-out for the live-handover WebSocket gateway. Leave OFF (or
# unset) on a SINGLE instance — Socket.io routes in-memory and never touches
# Redis. Set to `true` (REDIS_URL must be present) ONLY when you run MULTIPLE
# backend instances, so typing/handover events reach clients on other instances.
# Event-driven pub/sub (idle = zero Redis traffic) — not a polling drip.
SOCKET_IO_REDIS=false

# Clerk (authentication)
# Frontend API URL — this is the `iss` claim on Clerk tokens and the base for
# the JWKS endpoint. Prod: custom domain (e.g. https://clerk.klivo.app).
# Dev instance: https://<slug>.clerk.accounts.dev
CLERK_ISSUER=https://your-subdomain.clerk.accounts.dev
# Audience claim configured on the `klivo-api` JWT template. Optional — if unset
# the API validates issuer + signature only.
CLERK_JWT_AUDIENCE=klivo-api
# Backend API secret key (Clerk Dashboard → API keys). Server-side only.
CLERK_SECRET_KEY=sk_test_your_secret_key

# Resend (Email)
EMAIL_FROM="CodeWeaves <noreply@mail.codeweaves.com>"
RESEND_API_KEY=re_your_api_key_here

# Dashboard
DASHBOARD_URL=http://localhost:3000

# Agent Secrets Encryption (generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
AGENT_SECRET_KEY=

# Default webhook URL fallback (used when agent has no specific webhook configured)
DEFAULT_WEBHOOK_URL=

# Supabase (file uploads / storage only)
# Powers file storage. Live-handover realtime NO LONGER uses Supabase — it runs
# on our own Socket.io gateway (see SOCKET_IO_REDIS above); the widget/dashboard
# connect to OUR backend, never to Supabase with an anon key.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Voice Providers
SARVAM_API_KEY=
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_DEFAULT_VOICE_ID=

# ==============================================================================
# AI Orchestration (Phase 1 — native LLM calls, runs alongside n8n)
# ==============================================================================

# Model ID prefix convention (set in agent.aiConfig.modelId or DEFAULT_AI_MODEL):
#   provider/model          → OpenRouter (default, e.g. 'openai/gpt-4o-mini')
#   openrouter:<same>       → OpenRouter (explicit)
#   openai:<model>          → OpenAI direct          (e.g. 'openai:gpt-4o-mini')
#   gemini:<model>          → Google AI Studio       (e.g. 'gemini:gemini-2.5-flash')
#   groq:<model>            → Groq direct            (e.g. 'groq:llama-3.3-70b-versatile')

# OpenRouter: multi-LLM gateway (300+ models, OpenAI-compatible API).
# Sign up: https://openrouter.ai/
OPENROUTER_API_KEY=

# OpenAI direct. Sign up: https://platform.openai.com/api-keys
# Use `openai:<model>` model IDs to route through this provider directly
# (bypassing OpenRouter's 5% BYOK fee / 5.5% credit fee).
OPENAI_API_KEY=
# Optional OpenAI organisation for billing attribution.
OPENAI_ORGANIZATION=

# Google AI Studio (Gemini) direct. Sign up (free tier, no card required):
# https://aistudio.google.com/apikey
# Use `gemini:<model>` model IDs (e.g. 'gemini:gemini-2.5-flash').
GOOGLE_API_KEY=

# Groq direct (Llama 3.3 70B, Mixtral, etc. at 400+ tok/sec). Free tier:
# 30 req/min, 6000 req/day, no card required. Sign up:
# https://console.groq.com/keys
# Use `groq:<model>` model IDs (e.g. 'groq:llama-3.3-70b-versatile').
GROQ_API_KEY=

# Sarvam AI — India-hosted, Indic-native models (Hindi, Marathi, Tamil + English).
# Chat completion is free as of 2026. ₹1,000 sign-up credit for paid services.
# Dashboard: https://dashboard.sarvam.ai/
# Use `sarvam:<model>` model IDs (e.g. 'sarvam:sarvam-30b').

# Cerebras Cloud — wafer-scale-chip inference. Headline feature is raw
# throughput: gpt-oss-120b at ~3000 tok/s, zai-glm-4.7 at ~1000 tok/s.
# Free tier limits: 5 req/min, 30K tokens/min, 1M tokens/day.
# Public/free models: `gpt-oss-120b`, `zai-glm-4.7`. (Qwen / Llama families are
# Dedicated-Endpoint only — use Groq for Qwen-3-32B on a free tier.)
# Console: https://cloud.cerebras.ai
# Use `cerebras:<model>` model IDs (e.g. 'cerebras:gpt-oss-120b').
CEREBRAS_API_KEY=

# Default model for agents that don't specify one. Use a tool-capable model so
# features that rely on tool calling (e.g. human-handover's connect_to_human)
# work for agents that haven't picked a model. Avoid `:free` OpenRouter
# endpoints here — they often don't honour the tools parameter.
#   Examples (prefixed forms pick the provider):
#     openai:gpt-4.1                      — OpenAI direct, best tool following (default)
#     openai:gpt-4.1-mini                 — OpenAI direct, ~10× cheaper, still solid tools
#     gemini:gemini-2.5-flash             — Google direct, cheap + fast
#     groq:qwen/qwen3-32b                 — Groq direct, fast + multilingual
DEFAULT_AI_MODEL=openai:gpt-4.1

# Streaming timeout in milliseconds. If no token received within this window,
# the stream is aborted and an error is returned.
AI_STREAM_TIMEOUT_MS=60000

# Keep-alive heartbeat interval for LLM provider connections, in milliseconds.
# Default 25000ms (25s). Set to 0 to disable — first chat after a 30s+ idle
# period will then re-pay the TLS handshake (~300-3000ms cold-start tax).
# Tuned to undici's ~30s keep-alive timeout: 25s ensures sockets never go
# idle long enough to be closed. Cost: ~12k cheap unauthenticated GETs/hour
# per provider — trivial against any rate limit.
AI_KEEPALIVE_HEARTBEAT_MS=25000

# AI trace logging (Pino-backed, file + terminal)
# AI_TRACE_LOG_LEVEL     pino level: trace|debug|info|warn|error|fatal  (default: info)
# AI_TRACE_LOG_DIR       where ai-trace.log lives                       (default: logs)
# AI_TRACE_LOG_STDOUT    '1' to force terminal output in prod           (default: dev only)
# AI_TRACE_LOG_FILE      '0' to disable file output                     (default: enabled)
AI_TRACE_LOG_LEVEL=info
AI_TRACE_LOG_DIR=logs

# ==============================================================================
# Internal cron endpoints (classifier + data-capture extraction)
# ==============================================================================
# Shared secret for the machine-to-machine internal endpoints:
#   POST /internal/classifier/run       — runs the post-session classifier batch
#   POST /internal/data-extraction/run  — runs due data-capture extractions
#   POST /internal/handover/sweep       — auto-resolves idle/abandoned handovers
# These are @Public() (no JWT) and FAIL-CLOSED: if this is unset, the endpoints
# reject every request. REQUIRED in prod — an external scheduler (Render Cron,
# cron-job.org, Cloud Scheduler) POSTs with header `x-internal-secret: <value>`.
# Optional locally: the data-capture timer runs in-process and needs no secret.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_API_SECRET=

# ── Data-capture extraction (ALL optional; values shown are the defaults) ──────
# Background extraction of agent "data capture" fields from finished
# conversations. Postgres-scheduled (no Redis): each reply stamps a due time and
# a poll processes conversations whose time has passed.
DATA_EXTRACT_DEBOUNCE_MS=60000   # wait this long after the last message before extracting
DATA_EXTRACT_POLL_MS=30000       # how often the in-process timer checks for due conversations
DATA_EXTRACT_POLL_ENABLED=true   # in-process timer on/off. Set false in PROD only if you
#                                  # drive extraction via an external cron hitting the endpoint above.

# ── Human handover (optional; default shown) ───────────────────────────────────
# Minutes of silence before an untouched handover (REQUESTED or ACTIVE_HUMAN) is
# auto-resolved back to the bot by the /internal/handover/sweep cron. Lower =
# ghosts clear faster but a visitor who steps away briefly may get cut off;
# higher = more patient. 20 is a sane default for a small team.
HANDOVER_IDLE_MINUTES=20

# ==============================================================================
# WhatsApp Channel (optional — second agent channel via the official Cloud API)
# ==============================================================================
# Both vars below are required to RECEIVE webhooks. If unset, the WhatsApp webhook
# returns 503 and the channel is simply inactive — the rest of the API runs fine.

# Meta App secret (Meta dashboard → App settings → Basic → App Secret → Show).
# Used to verify the X-Hub-Signature-256 HMAC on every inbound webhook.
WHATSAPP_APP_SECRET=

# Webhook verify token — a string YOU choose (e.g. `openssl rand -hex 16`). Paste
# the SAME value into Meta → WhatsApp → Configuration → Webhook → "Verify token".
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# Optional Graph API version override. Defaults to v21.0 when unset.
# WHATSAPP_GRAPH_API_VERSION=v21.0

# NOTE: per-number values (phone number ID, WABA ID, access token) are NOT env
# vars — they're entered per-agent in the dashboard WhatsApp tab and stored
# encrypted (reusing AGENT_SECRET_KEY). The inbound queue rides on REDIS_URL above.
