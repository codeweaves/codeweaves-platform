# Dashboard Environment
NODE_ENV=development

# Clerk (authentication)
# Dashboard → API keys. The publishable key is safe to expose to the browser.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key
CLERK_SECRET_KEY=sk_test_your_secret_key
# Route Clerk to our custom Elements pages (invitation-only; no public sign-up)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# API. Also the origin the live-handover Socket.io gateway connects to (the
# dashboard opens a WebSocket to `${NEXT_PUBLIC_API_URL}/socket.io`). No secret
# needed — the browser is scoped by the Clerk-authed org; the widget by its
# unguessable session token. If the socket can't connect the Inbox falls back to
# a React Query poll (still works, just not instant).
NEXT_PUBLIC_API_URL=http://localhost:3001

# File storage (project URL only, no key). Uploaded agent logos and avatars are
# served from here. REQUIRED in production: the Content Security Policy allows
# images only from this origin, so without it they do not show in the editor.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Widget host. Used in the embed code snippet and allowed in the CSP frame-src
# (agent preview). Production: https://widget.getklivo.com
NEXT_PUBLIC_WIDGET_URL=http://localhost:5173

# Set by Vercel automatically, do not add: VERCEL_ENV, VERCEL_URL,
# VERCEL_PROJECT_PRODUCTION_URL (used for the CSP and Access-Control-Allow-Origin).

# Sentry
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
NEXT_PUBLIC_SENTRY_RELEASE=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
