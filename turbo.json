{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalEnv": [
    "DATABASE_URL",
    "DIRECT_URL",
    "AUTH0_DOMAIN",
    "AUTH0_AUDIENCE",
    "PORT",
    "CORS_ORIGIN",
    "npm_package_version",
    "NODE_ENV",
    "SENTRY_ORG",
    "SENTRY_PROJECT",
    "SENTRY_AUTH_TOKEN",
    "ANALYZE",
    "DEV",
    "OPENROUTER_API_KEY",
    "OPENROUTER_REFERER",
    "OPENAI_API_KEY",
    "OPENAI_ORGANIZATION",
    "GOOGLE_API_KEY",
    "GROQ_API_KEY",
    "DASHBOARD_URL",
    "DEFAULT_AI_MODEL",
    "AI_STREAM_TIMEOUT_MS",
    "AI_TRACE_LOG_LEVEL",
    "AI_TRACE_LOG_DIR",
    "AI_TRACE_LOG_STDOUT",
    "AI_TRACE_LOG_FILE"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^build", "^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "test/**", "jest.config.*"],
      "outputs": ["coverage/**"],
      "cache": false
    },
    "test:e2e": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "test/**", "jest.e2e.config.*"],
      "outputs": [],
      "cache": false
    },
    "test:cov": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "test/**", "jest.config.*"],
      "outputs": ["coverage/**"],
      "cache": false
    },
    "seed:analytics": {
      "cache": false
    },
    "seed:demo-agents": {
      "cache": false
    }
  }
}
